# ---- Core ----
NODE_ENV=development
PORT=10000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# ---- Data stores ----
# Redis (required for production / multi-instance matchmaking)
REDIS_URL=redis-cli -u redis://default:bbQ1g4hpd4WsDL3yGbyVr4qpjIn1unJu@letters-scent-seat-56433.db.redis.io:17093
# MongoDB (required for persistent abuse reports, bans, audit log)
MONGODB_URI=mongodb+srv://mauryaayush010907_db_user:ImKOpISFbOGzPeDg@cluster0.wfb86av.mongodb.net/

# ---- WebRTC ICE / TURN ----
# Extra STUN servers (comma-separated). Google STUN is always included.
STUN_URLS=
# TURN relay (Coturn). Provide either static credentials OR the REST-API key:
TURN_URL=turn:asia-east.relay.metered.ca:80
TURN_USERNAME=a17d369968453a12731f9f27
TURN_PASSWORD=QPvmISXJynupuW/J
# --- short-lived credentials (recommended for public deployment) ---
# Set to "true" to mint per-request Coturn temp-auth credentials.
# Requires `use-auth-secret`, `static-auth-secret` and `api-auth-secret` in Coturn.
TURN_USE_CONFIG=false
TURN_STATIC_SECRET=change-me-64-hex-chars
TURN_INSTANCE=drift

# ---- Safety / moderation ----
# Salt for IP hashing (any long random string)
HASH_SALT=8f98803e797331191f217c4475e3631358c865fff7739bb861e126dd53daa3be
# Key required by the /api/admin/* endpoints (x-admin-key header).
# Leave empty to disable the admin API entirely.
ADMIN_API_KEY=fe79ae99833e997ea8ac306910a8ee43de5f9155accdce542365d9686d1af2ca

# ---- Tuning (milliseconds / counts) ----
MATCH_FIND_COOLDOWN_MS=1500
SESSION_TTL_MS=600000
QUEUE_MAX_AGE_MS=120000
MAX_MESSAGE_LENGTH=500
CHATS_PER_2S=6
# How long a user with ACTIVE filters waits in refined matching before the
# server automatically (and visibly) expands their search to everyone.
PREFS_PATIENCE_MS=25000
